{
	"schemaVersion": 1,
	"id": "block-tracker",
	"version": "${version}",
	"name": "Block Tracker",
	"description": "Finds chests, shulker boxes, spawners and enchanting tables around you, with a HUD, a block list and a radar that marks players as friends or enemies.",
	"authors": [
		"Miguel Carmo"
	],
	"contact": {
		"homepage": "https://github.com/MCCProgrammer/block-tracker",
		"sources": "https://github.com/MCCProgrammer/block-tracker"
	},
	"license": "CC0-1.0",
	"icon": "assets/block-tracker/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mccprogrammer.blocktracker.BlockTracker"
		],
		"client": [
			"com.mccprogrammer.blocktracker.BlockTrackerClient"
		]
	},
	"mixins": [
		"block-tracker.mixins.json",
		{
			"config": "block-tracker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}